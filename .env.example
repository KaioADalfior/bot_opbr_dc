# Copie este arquivo para ".env" e preencha. NUNCA compartilhe o arquivo .env.
# O .env já está no .gitignore.

# Token do bot TEMPORÁRIO de configuração (Portal do Desenvolvedor > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# ID do servidor (Discord: Configurações > Avançado > Modo desenvolvedor; depois
# clique com o botão direito no ícone do servidor > Copiar ID do servidor)
DISCORD_GUILD_ID=

# Nome exato do servidor: o script se recusa a alterar um servidor com outro nome
DISCORD_GUILD_NAME=Ghost Recon Brasil

# (Opcional) Application ID, usado por "py main.py convite" antes de você ter o token
DISCORD_APPLICATION_ID=
