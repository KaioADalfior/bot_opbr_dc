# Copie para bot/.env e preencha. NUNCA compartilhe o bot/.env.

# Token do bot "Operação Brasil" (aplicação NOVA, diferente do bot de configuração)
BOT_TOKEN=

# ID do servidor
GUILD_ID=

# 1 = guardar o texto das conversas nas transcrições (exige ativar "Message Content Intent" no Portal)
# 0 = não pedir essa permissão (transcrições ficam só com anexos/embeds)
MESSAGE_CONTENT_INTENT=1

# Encerrar automaticamente denúncias paradas e pedidos de alteração sem resposta após N dias
TICKET_INATIVIDADE_DIAS=7

# Limites por membro
MAX_DENUNCIAS_ABERTAS=1
MAX_MODS_ABERTOS=2

# (Opcional) IDs dos cargos da equipe, separados por vírgula. Vazio = detectar pelos nomes
# "Líder Fundador", "Administração" e "Moderador".
IDS_CARGOS_EQUIPE=

# (Opcional) Nome ou ID dos canais usados pelo bot
CANAL_DENUNCIAS=denúncias
CANAL_PUBLICAR_MOD=publicar-mod
CANAL_MODS_PUBLICADOS=mods-publicados
CANAL_LOGS=logs-de-moderação
CANAL_RELATORIOS=relatórios

# ---------------- Transcripts por link ----------------
# 1 = o bot publica cada transcript numa página com link (senha continua obrigatória)
WEB_ATIVO=1
WEB_HOST=127.0.0.1
WEB_PORTA=8088
# PC de casa: deixe URL_PUBLICA vazia e WEB_TUNEL=cloudflared (link gratuito *.trycloudflare.com,
#   muda a cada vez que o bot reinicia). Instale: winget install --id Cloudflare.cloudflared
# VPS com domínio: URL_PUBLICA=https://transcripts.seudominio.com.br e WEB_TUNEL vazio
URL_PUBLICA=
WEB_TUNEL=cloudflared
# Dias que cada link fica disponível
TRANSCRIPT_DIAS=30

# --- Squads (#squad-partida) ---
# Minutos que a call do squad pode ficar vazia antes de ser apagada
SQUAD_VAZIO_MIN=10
# Máximo de squads abertos ao mesmo tempo
SQUAD_MAX=25
# 1 = membros não digitam em #abrir-squad e #squad-partida (só usam os botões)
SQUAD_TRAVAR_CANAL=1
# Canais (nome ou ID): painel para abrir squad e canal onde os cards são publicados
CANAL_ABRIR_SQUAD=abrir-squad
CANAL_SQUAD_PARTIDA=squad-partida

# --- VIP e contribuição ---
# Cargo VIP (nome sem emoji ou o ID)
CARGO_VIP=vip
# 1 = quem impulsiona o servidor vira VIP automaticamente (precisa de MEMBERS_INTENT=1)
BOOST_DA_VIP=1
# Exige ligar "SERVER MEMBERS INTENT" no Portal do Desenvolvedor (aba Bot)
MEMBERS_INTENT=1
MAX_CONTRIBUICOES_ABERTAS=1
CANAL_CONTRIBUICAO=contribuição
CANAL_VIPS=vips
